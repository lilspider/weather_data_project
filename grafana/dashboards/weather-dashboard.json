          "format": "time_series",
          "group": [],
          "metricColumn": "temp",
          "rawQuery": true,
          "rawSql": "SELECT \n    city,\n    (json_data::json->'query'->'location'->>'lat')::float as latitude,\n    (json_data::json->'query'->'location'->>'lon')::float as longitude,\n    temperature as temp,\n    (json_data::json->'query'->'current'->>'wind_degree')::int as wind_dir,\n    (json_data::json->'query'->'current'->>'wind_mph')::float as wind_speed,\n    recorded_at as time\nFROM dev.raw_weather_data \nWHERE (city, recorded_at) IN (\n    SELECT city, MAX(recorded_at) FROM dev.raw_weather_data GROUP BY 1\n)\nAND recorded_at >= $__timeFrom() AND recorded_at <= $__timeTo();",
          "refId": "A",
          "select": [
            [
              {
                "params": ["latitude"],
                "type": "column"
