          "rawSql": "SELECT \n    city,\n    (json_data::json->'query'->'location'->>'lat')::float as latitude,\n    (json_data::json->'query'->'location'->>'lon')::float as longitude,\n    temperature as temp,\n    recorded_at as time\nFROM dev.raw_weather_data \nWHERE recorded_at >= NOW() - INTERVAL '1 hour'\nORDER BY recorded_at DESC;",
